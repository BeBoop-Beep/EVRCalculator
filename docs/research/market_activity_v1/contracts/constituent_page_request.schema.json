{
  "$id": "constituent_page_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activityGenerationId": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "asOf": {
      "$ref": "common.schema.json#/$defs/Date"
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "marketKey": {
      "minLength": 1,
      "type": "string"
    },
    "rosterRef": {
      "$ref": "common.schema.json#/$defs/RosterRevision"
    },
    "windowDays": {
      "$ref": "common.schema.json#/$defs/WindowDays"
    }
  },
  "required": [
    "marketKey",
    "activityGenerationId",
    "rosterRef",
    "asOf",
    "windowDays",
    "limit",
    "cursor"
  ],
  "title": "constituent_page_request",
  "type": "object"
}
