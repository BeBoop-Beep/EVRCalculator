        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "askConfirmationMaxAgeHours",
        "soldHeadReceiptMaxAgeHours",
        "priceSummaryMinRecords",
        "percentileMinOtherPeers",
        "futureTimestampSkewSeconds",
        "tiePolicy"
      ],
      "type": "object"
    },
    "PriceSummary": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "basis": {
              "enum": [
                "PROVEN_WINDOW",
                "OBSERVED_ONLY"
              ]
            },
            "high": {
              "$ref": "#/$defs/NullableMoney"
            },
            "low": {
              "$ref": "#/$defs/NullableMoney"
            },
            "median": {
              "$ref": "#/$defs/NullableMoney"
            },
            "reasons": {
              "$ref": "#/$defs/ReasonList"
            },
            "recordCount": {
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "enum": [
                "AVAILABLE",
                "THIN",
                "NO_RECORDS"
              ]
            }
          },
          "required": [
            "state",
            "basis",
            "reasons",
            "recordCount",
            "median",
            "low",
            "high"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProofState": {
      "enum": [
        "PROVEN",
        "OBSERVED_ONLY"
      ]
    },
    "ReasonCode": {
      "enum": [
        "UNSUPPORTED_ASSET",
        "GENERATION_MISMATCH",
        "ACTIVITY_GENERATION_MISMATCH",
        "ACTIVITY_GENERATION_EXPIRED",
        "ROSTER_REVISION_UNSTABLE",
        "QUERY_FINGERPRINT_IS_NOT_A_REVISION",
        "ROSTER_REVISION_MISMATCH",
        "ROSTER_INTEGRITY_VIOLATION",
        "CURSOR_INVALID",
        "CURSOR_MISMATCH",
        "INSTRUMENT_NOT_IN_ROSTER",
        "INVALID_INSTRUMENT_KEY",
        "ATTRIBUTION_MISSING",
        "ATTRIBUTION_SHARED",
        "ATTRIBUTION_UNKNOWN",
        "PROVIDER_VARIANT_MISSING",
        "PROVIDER_VARIANT_UNPARSED_TOKENS",
        "CANDIDATE_SET_INCOMPLETE",
        "IDENTITY_EDITION_UNPROVEN",
        "IDENTITY_PRINTING_UNPROVEN",
        "IDENTITY_SPECIAL_TYPE_UNSUPPORTED",
        "IDENTITY_NO_MATCH",
        "IDENTITY_AMBIGUOUS",
        "CURRENCY_UNSUPPORTED",
        "GRADING_INCOMPLETE",
        "GRADER_UNRECOGNIZED",
        "GRADE_UNRECOGNIZED",
        "QUALIFIER_UNRECOGNIZED",
        "TIER_MISMATCH",
        "EVIDENCE_DUPLICATE",
        "EVIDENCE_CONFLICT",
        "INVALID_EVIDENCE_ROW",
        "NOT_COLLECTED",
        "COMPLETENESS_RECEIPT_MISSING",
        "SYNC_STATUS_NOT_PROOF",
        "WALK_RECEIPT_MALFORMED",
        "WALK_PAGINATION_UNKNOWN",
        "WALK_BINDING_MISMATCH",
        "WALK_SORT_NOT_DATE_DESC",
        "WALK_HEAD_UNKNOWN",
        "WALK_CURSOR_CHAIN_BROKEN",
        "WALK_FILTER_UNSTABLE",
        "WALK_NOT_DATE_DESCENDING",
        "STREAM_DOES_NOT_COVER_TIER",
        "COMBINED_STREAM_SEMANTICS_UNPROVEN",
        "LOWER_BOUNDARY_NOT_REACHED",
        "BOUNDARY_DATE_PARTIALLY_FETCHED",
        "RIGHT_EDGE_UNRECONCILED",
        "RIGHT_EDGE_INVALID",
        "RIGHT_EDGE_IN_FUTURE",
        "RIGHT_EDGE_BINDING_MISMATCH",
        "RIGHT_EDGE_DAY_OPEN",
        "RIGHT_EDGE_STALE",
        "LATE_INGESTION_AFTER_RECONCILIATION",
        "CHECKPOINT_PAGES_PENDING",
        "SAME_INGESTION_TIMESTAMP_UNDRAINED",
        "SUPPLY_COLLECTION_FAILED",
        "SOURCE_CONFIRMATION_MISSING",
        "SOURCE_CONFIRMATION_IN_FUTURE",
        "SOURCE_CONFIRMATION_MIXED",
        "SOURCE_CONFIRMATION_REPEATED",
        "UNCONFIRMED_OFFERS_EXCLUDED",
        "ASKS_STALE",
        "EMPTY_WITHOUT_SOURCE_FRESHNESS",
        "SUPPLY_PAGINATION_UNKNOWN",
        "SUPPLY_PAGINATION_CONTRADICTORY",
        "DEPTH_TRUNCATED",
        "SHIPPING_UNKNOWN",
        "SHIPPING_LEGACY_UNVERIFIED",
        "QUANTITY_DEFAULTED",
        "QUANTITY_LEGACY_UNVERIFIED",
        "THIN_RECORDS",
        "NO_RECORDS",
        "NO_PEERS",
        "INSUFFICIENT_PEERS",
        "ALL_ZERO",
        "ALL_PEERS_TIED",
        "ZERO_BASELINE",
        "BASELINE_MISSING",
        "WINDOW_NOT_PROVEN",
        "FEATURE_DISABLED_V1"
      ],
      "type": "string"
    },
    "ReasonList": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "type": "array"
    },
    "Roster": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "label": {
              "const": "Activity for current constituents"
            },
            "membershipContractVersion": {
              "const": "fma_membership_v2"
            },
            "membershipMode": {
              "const": "CURRENT_ROSTER_RETROSPECTIVE"
            },
            "rosterAsOf": {
              "$ref": "#/$defs/Date"
            },
            "rosterDenominator": {
              "minimum": 0,
              "type": "integer"
            },
            "rosterRevision": {
              "$ref": "#/$defs/RosterRevision"
            }
          },
          "required": [
            "membershipMode",
            "label",
            "membershipContractVersion",
            "rosterAsOf",
            "rosterRevision",
            "rosterDenominator"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RosterRevision": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "generationId": {
              "$ref": "#/$defs/Uuid"
            },
            "kind": {
              "const": "SURFACE_V2_GENERATION"
            },
            "marketKey": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "generationId",
            "marketKey"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "computedThrough": {
              "$ref": "#/$defs/Date"
            },
            "kind": {
              "const": "QUERY_CACHE_PUBLISHED_REVISION"
            },
            "queryFingerprint": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "revisionId": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "kind",
            "queryFingerprint",
            "revisionId",
            "computedThrough"
          ],
          "type": "object"
        }
      ]
    },
    "SaleCountPoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "firstIngestedAt": {
          "$ref": "#/$defs/NullableDateTime"
        },
        "ingestedAfterReconciliation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lastIngestedAt": {
          "$ref": "#/$defs/NullableDateTime"
        },
        "observedCount": {
          "minimum": 1,
          "type": "integer"
        },
        "proofState": {
          "$ref": "#/$defs/ProofState"
        }
      },
      "required": [
        "date",
        "observedCount",
        "proofState",
        "firstIngestedAt",
        "lastIngestedAt",
        "ingestedAfterReconciliation"
      ],
      "type": "object"
    },
    "SalePricePoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "high": {
          "$ref": "#/$defs/Money"
        },
        "low": {
          "$ref": "#/$defs/Money"
        },
        "median": {
          "$ref": "#/$defs/Money"
        },
        "recordCount": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "date",
        "recordCount",
        "low",
        "median",
        "high"
      ],
      "type": "object"
    },
    "SalesWindow": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "$ref": "#/$defs/WindowDays"
        },
        "endDate": {
          "$ref": "#/$defs/Date"
        },
        "observedCount": {
          "$ref": "#/$defs/NullableCount"
        },
        "priceSummary": {
          "$ref": "#/$defs/PriceSummary"
        },
        "provenCount": {
          "$ref": "#/$defs/NullableCount"
        },
        "readiness": {
          "$ref": "#/$defs/WindowReadiness"
        },
        "startDate": {
          "$ref": "#/$defs/Date"
        }
      },
      "required": [
        "days",
        "startDate",
        "endDate",
        "readiness",
        "observedCount",
        "provenCount",
        "priceSummary"
      ],
      "type": "object"
    },
    "SupplyListingPoint": {
      "additionalProperties": false,
      "properties": {
        "collectionCount": {
          "minimum": 1,
          "type": "integer"
        },
        "confirmationsOnDate": {
          "minimum": 1,
          "type": "integer"
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "depth": {
          "enum": [
            "LOWER_BOUND",
            "COMPLETE_AT_SOURCE",
            "UNKNOWN",
            null
          ]
        },
        "firstCollectedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "lastCollectedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "providerConfirmedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "stateAtCollection": {
          "$ref": "#/$defs/AskState"
        },
        "value": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "date",
        "providerConfirmedAt",
        "firstCollectedAt",
        "lastCollectedAt",
        "collectionCount",
        "confirmationsOnDate",
        "stateAtCollection",
        "depth",
        "value"
      ],
      "type": "object"
    },
    "SupplyQuantityPoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "provenance": {
          "enum": [
            "PROVEN",
            "EXPLICIT",
            "DEFAULTED_LOWER_BOUND",
            "LEGACY_UNVERIFIED"
          ]
        },
        "providerConfirmedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "value": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "date",
        "providerConfirmedAt",
        "provenance",
        "value"
      ],
      "type": "object"
    },
    "Uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Versions": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "grading": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "membership": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "peerPopulation": {
          "type": "string"
        },
        "qualifierRegistry": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "supplyProvenance": {
          "type": "string"
        },
        "tiePolicy": {
          "type": "string"
        },
        "windowReadiness": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "domain",
        "identity",
        "grading",
        "qualifierRegistry",
        "observation",
        "windowReadiness",
        "supplyProvenance",
        "series",
        "tiePolicy",
        "peerPopulation",
        "membership",
        "cursor"
      ],
      "type": "object"
    },
    "WindowDays": {
      "enum": [
        7,
        30,
        90,
        180
      ],
      "type": "integer"
    },
    "WindowReadiness": {
      "additionalProperties": false,
      "properties": {
        "exhausted": {
          "type": "boolean"
        },
        "provenLowerBoundDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "$ref": "#/$defs/ReasonList"
        },
        "reconciledThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "PROVEN",
            "PARTIAL",
            "UNPROVEN",
            "NOT_COLLECTED"
          ]
        }
      },
      "required": [
        "state",
        "reasons",
        "provenLowerBoundDate",
        "exhausted",
        "reconciledThrough"
      ],
      "type": "object"
    }
  },
  "$id": "common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Focused Market Activity V1 shared definitions"
}
