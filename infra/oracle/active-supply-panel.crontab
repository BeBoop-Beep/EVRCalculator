# Core Panel V1 active supply. Application cron on the scraper VM; never GitHub schedule.
# Times are America/Phoenix and execute the detached SHA-pinned runtime worktree.
CRON_TZ=America/Phoenix

10 21 * * * /home/ubuntu/state/active_supply_panel/runtime/infra/oracle/run_active_supply_panel.sh >> /home/ubuntu/repos/EVRCalculator/backend/logs/active_supply_panel.log 2>&1
40 21 * * * /home/ubuntu/state/active_supply_panel/runtime/infra/oracle/run_active_supply_panel.sh >> /home/ubuntu/repos/EVRCalculator/backend/logs/active_supply_panel.log 2>&1

# Materialize explicit RUN_MISSING rows after the retry window; never infer disappearance.
10 22 * * * /home/ubuntu/state/active_supply_panel/runtime/infra/oracle/run_active_supply_health.sh >> /home/ubuntu/repos/EVRCalculator/backend/logs/active_supply_panel_health.log 2>&1
