# Host timezone MUST be America/Phoenix.

# Heartbeat
0 * * * * echo "VM heartbeat $(date)" >> /home/ubuntu/repos/EVRCalculator/vm_heartbeat.log

# Daily scrape lifecycle
0 1 * * * cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python backend/scripts/reconcile_stale_scrape_jobs.py --commit >> /home/ubuntu/repos/EVRCalculator/backend/logs/reconcile_stale_scrape_jobs.log 2>&1
5 1 * * * cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python backend/scripts/create_daily_scrape_batch.py --trigger-source scheduled >> /home/ubuntu/repos/EVRCalculator/backend/logs/create_daily_scrape_batch.log 2>&1
* * * * * /usr/bin/flock -n /tmp/pokemon-scrape-dispatcher.lock -c 'cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python backend/scripts/run_next_scrape_job.py' >> /home/ubuntu/repos/EVRCalculator/backend/logs/cron_dispatcher.log 2>&1
0 6 * * * cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python backend/scripts/publish_post_scrape_if_needed.py >> /home/ubuntu/repos/EVRCalculator/backend/logs/rebuild_snapshots_after_scrape.cron.log 2>&1

# Pokemon set onboarding
*/5 5-7 * * * /usr/bin/flock -n /tmp/pokemon-set-onboarding.lock /home/ubuntu/bin/run_pokemon_onboarding_worker.sh commit >> /home/ubuntu/logs/pokemon_set_onboarding.log 2>&1
0-30/5 8 * * * /usr/bin/flock -n /tmp/pokemon-set-onboarding.lock /home/ubuntu/bin/run_pokemon_onboarding_worker.sh commit >> /home/ubuntu/logs/pokemon_set_onboarding.log 2>&1

# Market Explorer maintained caches
5-59/15 * * * * /usr/bin/flock -n /tmp/market-explorer-prewarm.lock sh -c 'cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python -m backend.scripts.run_market_explorer_maintained_cache_prewarm --commit' >> /home/ubuntu/repos/EVRCalculator/backend/logs/market_explorer_prewarm.log 2>&1
10-59/15 * * * * /usr/bin/flock -n /tmp/market-explorer-health.lock sh -c 'cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python -m backend.scripts.check_market_explorer_maintained_cache_health' >> /home/ubuntu/repos/EVRCalculator/backend/logs/market_explorer_health.log 2>&1

# Sentinel
* * * * * /usr/bin/flock -n /tmp/index-alert-dispatcher.lock -c 'cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python -m backend.alerts.dispatcher' >> /home/ubuntu/repos/EVRCalculator/backend/logs/alert_dispatcher.log 2>&1
*/5 * * * * /usr/bin/flock -n /tmp/index-market-freshness-watchdog.lock -c 'cd /home/ubuntu/repos/EVRCalculator && /home/ubuntu/repos/EVRCalculator/.venv/bin/python -m backend.alerts.market_freshness_watchdog' >> /home/ubuntu/repos/EVRCalculator/backend/logs/market_freshness_watchdog.log 2>&1
