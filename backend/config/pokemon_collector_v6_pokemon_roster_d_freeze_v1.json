{
  "artifactVersion": "pokemon_collector_v6_pokemon_roster_d_freeze_v1",
  "status": "FROZEN",
  "createdFor": "POKEMON_COLLECTOR_D_FORMULA_ARTIFACT_MISSING remediation (narrow construct-calibration task)",
  "formula": {
    "formulaName": "pokemon_roster_d_headline_strength_bounded_breadth_v1",
    "architecture": "D_pokemon = S + (100 - S) * lambda_breadth * B",
    "strength": {
      "description": "Fixed geometric-decay weighted contribution from the N strongest qualifying (appeal>50) distinct Pokemon subjects, weights summing to exactly 1, applied to a monotonic ceiling-stretch transform of each subject's raw desirability_score. The stretch (exponent k>1 on the appeal fraction above the qualifying floor) magnifies differences among near-ceiling subjects (90-99 range, which is where most sets' headline Pokemon cluster because iconic species recur across the catalog) without altering ranking order, which is what resolves the near-ceiling compression a plain weighted average produces.",
      "qualifyingFilter": "appeal > 50 (strictly); appeal<=50 subjects never enter the top-N ranking and contribute exactly 0",
      "N_headline_subjects": 8,
      "decayRatio_r": 0.6,
      "stretchExponent_k": 4,
      "weightFormula": "w_i = r^(i-1)*(1-r) / (1-r^N) for i=1..N, sum(w_i)=1 exactly",
      "weights_position1_to_N": [
        0.4068332361273121,
        0.24409994167638727,
        0.14645996500583236,
        0.0878759790034994,
        0.05272558740209965,
        0.031635352441259784,
        0.01898121146475587,
        0.011388726878853521
      ],
      "stretchFormula": "stretch(appeal) = 50 + 50 * (clamp((appeal-50)/50, 0, 1))^k -- identity at appeal=50 (maps to 50) and appeal=100 (maps to 100); strictly increasing for all k>0 so it can never reverse a ranking",
      "paddingRule": "if fewer than N qualifying subjects exist, missing positions contribute 0 (never fabricated, never renormalized to inflate the remaining weights)",
      "equation": "S = sum_{i=1..N} w_i * stretch(appeal_(i)) where appeal_(1) >= appeal_(2) >= ... are the sorted qualifying distinct-subject raw desirability_score values (missing positions beyond roster depth = 0)"
    },
    "breadth": {
      "description": "Bounded, saturating count of subjects with meaningful appeal above a fixed semantic anchor on the raw 0-100 composite scale.",
      "threshold_T": 60.0,
      "contributionPerSubject": "b_i = clamp((appeal_i - T) / (100 - T), 0, 1)",
      "aggregation": "B = 1 - exp(-sum(b_i) / K)",
      "saturationConstant_K": 4.0,
      "range": "[0, 1)"
    },
    "lambda_breadth": 0.2,
    "fewerThanNSubjectsHandling": "There is no fixed N; Strength sums over however many qualifying (appeal>50) distinct subjects actually exist. A roster with few qualifying subjects simply has fewer nonzero terms and a lower weight-mass total -- this correctly penalizes small/shallow rosters instead of inflating their per-subject weights via renormalization.",
    "neutralSubjectHandling": "Subjects with appeal<=50 are excluded entirely from the Strength ranking/weighting pool (they can never occupy a headline slot, contribute exactly 0) and contribute 0 to Breadth (clamped at threshold T=60 > 50). This guarantees appeal=50 additions are always exact no-ops for D_pokemon.",
    "duplicatePolicy": "One entry per distinct Pokemon species per set; multiple printings of the same species are deduplicated to a single representative appeal value upstream, at Phase 1 group construction (see sourceBaseline). D_pokemon never receives duplicate raw entries.",
    "missingSubjectPolicy": "Pokemon with no fan-popularity/Trends evidence are excluded from the distinct-subject list entirely (not imputed as 0 or 50); this matches the upstream Trends V2 capture's SCORED/scored_zero_high_confidence/failed classification -- only SCORED and scored_zero_high_confidence subjects carry a desirability_score into this formula.",
    "sourceBaselineIdentity": "backend/artifacts/collector_v6_redesign_research/pokemon_D_corrected_128set.json (pokeAppeals field per set) -- rebuilt from the raw locked composite desirability_score = 0.75*fan_popularity_score + 0.25*current_trend_score (corrected Trends V2), NO percentile transform.",
    "trendsV2Dependency": {
      "manifest": "pokemon_trends_anchor_ladder_manifest_v1",
      "codeVersion": "capture_pokemon_trends_anchor_ladder_v2_r1",
      "checkpoint": "backend/artifacts/collector_v6_redesign_research/trends_v2_capture/checkpoint_rows.jsonl",
      "coverage": "1025/1025 canonical subjects; SCORED=993, scored_zero_high_confidence=27, failed=5"
    },
    "rawCompositeNoPercentileRule": "desirability_score consumed RAW (0-100 composite scale); no percentile/z-score/rank transform applied anywhere in S, B, or D_pokemon.",
    "priceUsageDisclosure": "No market/price/value data was used in candidate selection, threshold selection, lambda selection, or formula freeze at any point.",
    "rejectedPriorFormula": "D = 100*(1-exp(-sum(sqrt(max((appeal-50)/50,0)))/6)) [old C4 roster-mass] -- explicitly rejected, not reused, not a special case of this formula."
  },
